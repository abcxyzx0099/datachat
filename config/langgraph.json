{
  "graph_name": "survey_analysis",
  "graph_version": "1.0.0",
  "description": "22-step LangGraph StateGraph for SPSS survey data analysis and visualization",
  "state_class": "WorkflowState",
  "checkpointer_type": "sqlite",
  "checkpointer_path": "checkpoints.db",
  "nodes": [
    {
      "id": "extract_spss_node",
      "name": "Extract SPSS File",
      "step_number": 1,
      "phase": "Extraction & Preparation",
      "type": "deterministic",
      "description": "Extract data and metadata from .sav file using pyreadstat"
    },
    {
      "id": "transform_metadata_node",
      "name": "Transform Metadata",
      "step_number": 2,
      "phase": "Extraction & Preparation",
      "type": "deterministic",
      "description": "Transform metadata to variable-centered format"
    },
    {
      "id": "filter_metadata_node",
      "name": "Filter Metadata",
      "step_number": 3,
      "phase": "Extraction & Preparation",
      "type": "deterministic",
      "description": "Filter metadata to variables requiring recoding"
    },
    {
      "id": "generate_recoding_rules_node",
      "name": "Generate Recoding Rules",
      "step_number": 4,
      "phase": "New Dataset Generation",
      "type": "ai",
      "description": "LLM generates recoding rules for data transformation"
    },
    {
      "id": "validate_recoding_rules_node",
      "name": "Validate Recoding Rules",
      "step_number": 5,
      "phase": "New Dataset Generation",
      "type": "validation",
      "description": "Validate recoding rules (syntax, references, constraints)"
    },
    {
      "id": "review_recoding_rules_node",
      "name": "Review Recoding Rules",
      "step_number": 6,
      "phase": "New Dataset Generation",
      "type": "review",
      "description": "Human review of recoding rules with approve/reject"
    },
    {
      "id": "generate_pspp_recoding_syntax_node",
      "name": "Generate PSPP Recoding Syntax",
      "step_number": 7,
      "phase": "New Dataset Generation",
      "type": "deterministic",
      "description": "Convert recoding rules to PSPP syntax"
    },
    {
      "id": "execute_pspp_recoding_node",
      "name": "Execute PSPP Recoding",
      "step_number": 8,
      "phase": "New Dataset Generation",
      "type": "deterministic",
      "description": "Execute PSPP recoding, create new_data.sav"
    },
    {
      "id": "generate_indicators_node",
      "name": "Generate Indicators",
      "step_number": 9,
      "phase": "Indicator Generation",
      "type": "ai",
      "description": "LLM groups variables into semantic indicators"
    },
    {
      "id": "validate_indicators_node",
      "name": "Validate Indicators",
      "step_number": 10,
      "phase": "Indicator Generation",
      "type": "validation",
      "description": "Validate indicator structure and references"
    },
    {
      "id": "review_indicators_node",
      "name": "Review Indicators",
      "step_number": 11,
      "phase": "Indicator Generation",
      "type": "review",
      "description": "Human review of indicators with approve/reject"
    },
    {
      "id": "generate_table_specifications_node",
      "name": "Generate Table Specifications",
      "step_number": 12,
      "phase": "Cross-Table Generation",
      "type": "ai",
      "description": "LLM defines cross-table structures"
    },
    {
      "id": "validate_table_specifications_node",
      "name": "Validate Table Specifications",
      "step_number": 13,
      "phase": "Cross-Table Generation",
      "type": "validation",
      "description": "Validate table specifications"
    },
    {
      "id": "review_table_specifications_node",
      "name": "Review Table Specifications",
      "step_number": 14,
      "phase": "Cross-Table Generation",
      "type": "review",
      "description": "Human review of table specifications with approve/reject"
    },
    {
      "id": "generate_pspp_table_syntax_node",
      "name": "Generate PSPP Table Syntax",
      "step_number": 15,
      "phase": "Cross-Table Generation",
      "type": "deterministic",
      "description": "Generate PSPP CTABLES syntax"
    },
    {
      "id": "execute_pspp_tables_node",
      "name": "Execute PSPP Tables",
      "step_number": 16,
      "phase": "Cross-Table Generation",
      "type": "deterministic",
      "description": "Execute PSPP, generate cross-tables"
    },
    {
      "id": "generate_python_statistics_script_node",
      "name": "Generate Statistics Script",
      "step_number": 17,
      "phase": "Statistical Analysis",
      "type": "deterministic",
      "description": "Generate Chi-square statistics script"
    },
    {
      "id": "execute_python_statistics_script_node",
      "name": "Execute Statistics Script",
      "step_number": 18,
      "phase": "Statistical Analysis",
      "type": "deterministic",
      "description": "Execute statistics script"
    },
    {
      "id": "generate_filter_list_node",
      "name": "Generate Filter List",
      "step_number": 19,
      "phase": "Significant Tables Selection",
      "type": "deterministic",
      "description": "Generate significance filter criteria"
    },
    {
      "id": "apply_filter_to_tables_node",
      "name": "Apply Filter to Tables",
      "step_number": 20,
      "phase": "Significant Tables Selection",
      "type": "deterministic",
      "description": "Filter to significant tables only"
    },
    {
      "id": "generate_powerpoint_node",
      "name": "Generate PowerPoint",
      "step_number": 21,
      "phase": "Executive Summary Presentation",
      "type": "deterministic",
      "description": "Create PowerPoint presentation from significant tables"
    },
    {
      "id": "generate_html_dashboard_node",
      "name": "Generate HTML Dashboard",
      "step_number": 22,
      "phase": "Full Report Dashboard",
      "type": "deterministic",
      "description": "Create HTML dashboard from all tables"
    }
  ],
  "edges": [
    {"from": "START", "to": "extract_spss_node"},
    {"from": "extract_spss_node", "to": "transform_metadata_node"},
    {"from": "transform_metadata_node", "to": "filter_metadata_node"},
    {"from": "filter_metadata_node", "to": "generate_recoding_rules_node"},
    {"from": "generate_pspp_recoding_syntax_node", "to": "execute_pspp_recoding_node"},
    {"from": "execute_pspp_recoding_node", "to": "generate_indicators_node"},
    {"from": "generate_pspp_table_syntax_node", "to": "execute_pspp_tables_node"},
    {"from": "execute_pspp_tables_node", "to": "generate_python_statistics_script_node"},
    {"from": "generate_python_statistics_script_node", "to": "execute_python_statistics_script_node"},
    {"from": "execute_python_statistics_script_node", "to": "generate_filter_list_node"},
    {"from": "generate_filter_list_node", "to": "apply_filter_to_tables_node"},
    {"from": "apply_filter_to_tables_node", "to": "generate_powerpoint_node"},
    {"from": "generate_powerpoint_node", "to": "generate_html_dashboard_node"},
    {"from": "generate_html_dashboard_node", "to": "END"}
  ],
  "conditional_edges": [
    {
      "id": "recoding_validation_routing",
      "from": "validate_recoding_rules_node",
      "routing_function": "should_retry_recoding",
      "description": "Route after recoding validation: retry on failure, review on pass",
      "routes": [
        {"condition": "validation_failed", "to": "generate_recoding_rules_node"},
        {"condition": "validation_passed_not_approved", "to": "review_recoding_rules_node"},
        {"condition": "approved", "to": "generate_pspp_recoding_syntax_node"}
      ]
    },
    {
      "id": "recoding_review_routing",
      "from": "review_recoding_rules_node",
      "routing_function": "should_approve_recoding",
      "description": "Route after recoding review: proceed on approve, retry on reject",
      "routes": [
        {"condition": "approved", "to": "generate_pspp_recoding_syntax_node"},
        {"condition": "rejected", "to": "generate_recoding_rules_node"}
      ]
    },
    {
      "id": "indicators_validation_routing",
      "from": "validate_indicators_node",
      "routing_function": "should_retry_indicators",
      "description": "Route after indicators validation: retry on failure, review on pass",
      "routes": [
        {"condition": "validation_failed", "to": "generate_indicators_node"},
        {"condition": "validation_passed_not_approved", "to": "review_indicators_node"},
        {"condition": "approved", "to": "generate_table_specifications_node"}
      ]
    },
    {
      "id": "indicators_review_routing",
      "from": "review_indicators_node",
      "routing_function": "should_approve_indicators",
      "description": "Route after indicators review: proceed on approve, retry on reject",
      "routes": [
        {"condition": "approved", "to": "generate_table_specifications_node"},
        {"condition": "rejected", "to": "generate_indicators_node"}
      ]
    },
    {
      "id": "table_specs_validation_routing",
      "from": "validate_table_specifications_node",
      "routing_function": "should_retry_table_specs",
      "description": "Route after table specs validation: retry on failure, review on pass",
      "routes": [
        {"condition": "validation_failed", "to": "generate_table_specifications_node"},
        {"condition": "validation_passed_not_approved", "to": "review_table_specifications_node"},
        {"condition": "approved", "to": "generate_pspp_table_syntax_node"}
      ]
    },
    {
      "id": "table_specs_review_routing",
      "from": "review_table_specifications_node",
      "routing_function": "should_approve_table_specs",
      "description": "Route after table specs review: proceed on approve, retry on reject",
      "routes": [
        {"condition": "approved", "to": "generate_pspp_table_syntax_node"},
        {"condition": "rejected", "to": "generate_table_specifications_node"}
      ]
    }
  ],
  "three_node_patterns": [
    {
      "id": "recoding_pattern",
      "name": "Recoding Rules Pattern",
      "steps": [4, 5, 6],
      "nodes": [
        "generate_recoding_rules_node",
        "validate_recoding_rules_node",
        "review_recoding_rules_node"
      ],
      "description": "Generate → Validate → Review pattern for recoding rules"
    },
    {
      "id": "indicators_pattern",
      "name": "Indicators Pattern",
      "steps": [9, 10, 11],
      "nodes": [
        "generate_indicators_node",
        "validate_indicators_node",
        "review_indicators_node"
      ],
      "description": "Generate → Validate → Review pattern for indicators"
    },
    {
      "id": "table_specs_pattern",
      "name": "Table Specifications Pattern",
      "steps": [12, 13, 14],
      "nodes": [
        "generate_table_specifications_node",
        "validate_table_specifications_node",
        "review_table_specifications_node"
      ],
      "description": "Generate → Validate → Review pattern for table specifications"
    }
  ],
  "phases": [
    {
      "id": "phase1",
      "name": "Extraction & Preparation",
      "steps": [1, 2, 3],
      "description": "Extract data and prepare metadata"
    },
    {
      "id": "phase2",
      "name": "New Dataset Generation",
      "steps": [4, 5, 6, 7, 8],
      "description": "Generate and apply recoding rules to create new dataset",
      "has_three_node_pattern": true
    },
    {
      "id": "phase3",
      "name": "Indicator Generation",
      "steps": [9, 10, 11],
      "description": "Group variables into semantic indicators",
      "has_three_node_pattern": true
    },
    {
      "id": "phase4",
      "name": "Cross-Table Generation",
      "steps": [12, 13, 14, 15, 16],
      "description": "Generate and execute cross-table specifications",
      "has_three_node_pattern": true
    },
    {
      "id": "phase5",
      "name": "Statistical Analysis",
      "steps": [17, 18],
      "description": "Compute Chi-square and Cramer's V statistics"
    },
    {
      "id": "phase6",
      "name": "Significant Tables Selection",
      "steps": [19, 20],
      "description": "Filter tables based on statistical significance"
    },
    {
      "id": "phase7",
      "name": "Executive Summary Presentation",
      "steps": [21],
      "description": "Generate PowerPoint presentation"
    },
    {
      "id": "phase8",
      "name": "Full Report Dashboard",
      "steps": [22],
      "description": "Generate HTML dashboard"
    }
  ]
}
