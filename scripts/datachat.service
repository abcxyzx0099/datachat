# =============================================================================
# DataChat Survey Analyzer - Systemd Service File
# =============================================================================
# Installation:
#   sudo cp scripts/datachat.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable datachat
#   sudo systemctl start datachat
# =============================================================================

[Unit]
Description=DataChat Survey Analyzer
Documentation=https://github.com/yourusername/datachat
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=surveychat
Group=surveychat
WorkingDirectory=/opt/survey-analyzer

# Environment
Environment="PATH=/opt/survey-analyzer/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-/opt/survey-analyzer/.env

# ExecStart
ExecStart=/opt/survey-analyzer/venv/bin/langgraph dev --port 8123 --host 0.0.0.0

# Auto-restart on failure
Restart=always
RestartSec=10
StartLimitInterval=60
StartLimitBurst=3

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/survey-analyzer/output
ReadWritePaths=/opt/survey-analyzer/temp
ReadWritePaths=/opt/survey-analyzer/logs
ReadWritePaths=/opt/survey-analyzer/checkpoints.db

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=datachat

[Install]
WantedBy=multi-user.target
