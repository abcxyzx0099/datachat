# =============================================================================
# LangGraph Configuration for DataChat Survey Analysis
# =============================================================================

# -----------------------------------------------------------------------------
# Client-side configuration (used by browser)
# -----------------------------------------------------------------------------
# For reverse proxy setup, use relative path "/api"
# This works for both localhost (http://localhost:3000) and production domain
NEXT_PUBLIC_API_URL=/api

# -----------------------------------------------------------------------------
# Server-side configuration (used by Next.js API routes)
# -----------------------------------------------------------------------------
# Direct connection to backend for server-to-server communication
LANGGRAPH_API_URL=http://127.0.0.1:8123

# -----------------------------------------------------------------------------
# Assistant/Graph ID
# -----------------------------------------------------------------------------
# The ID of the LangGraph assistant to connect to
NEXT_PUBLIC_ASSISTANT_ID=survey_analysis

# -----------------------------------------------------------------------------
# LangSmith API Key (optional)
# -----------------------------------------------------------------------------
# Only required for production deployments with hosted LangGraph
# Do NOT prefix with "NEXT_PUBLIC_" as we do not want this exposed in client code
LANGSMITH_API_KEY=

# =============================================================================
# Configuration Notes
# =============================================================================
#
# Development (localhost):
#   - Frontend runs on http://localhost:3000
#   - Backend runs on http://127.0.0.1:8123
#   - Reverse proxy (nginx) routes /api to backend
#
# Production (with reverse proxy):
#   - Frontend: https://www.sysy.site/
#   - API: https://www.sysy.site/api/
#   - Studio: https://www.sysy.site/studio/
#
# The relative path "/api" works in both environments because the browser
# automatically uses the current domain.
