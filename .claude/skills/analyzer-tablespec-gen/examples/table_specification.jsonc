{
  "metadata": {
    "spec_id": "crosstab_2024_consumer_survey_001",
    "project_id": "proj_2024_china_consumer_insights",
    "dataset_id": "ds_q1_2024_national_survey",
    "description": "Cross-tabulation analysis for market research survey"
  },

  "filter_clause": {
    "age_min": 18,
    "age_max": 65,
    "exclude_incomplete": true
  },

  "weight_indicator": "weight1",

  "row_indicators": [
    // Raw - Direct SPSS variable, no transformation
    {
      "indicator_code": "Q1_GENDER_RAW",
      "question_code": "Q1",
      "question_description": "Gender",
      "question_label": "请问您的性别是？(单选)",
      "question_type": "Single Choice",
      "source_variables": ["Q1_GENDER"],
      "transformation_rules": null,
      "statistic_type": "categorical"
    },
    // Raw - Direct SPSS variable (scalar)
    {
      "indicator_code": "S1_AGE",
      "question_code": "S1",
      "question_description": "Age",
      "question_label": "请问您的年龄是？",
      "question_type": "Numeric Input",
      "source_variables": ["S1_AGE"],
      "transformation_rules": null,
      "statistic_type": "scalar"
    },
    // Raw - Direct SPSS variable
    {
      "indicator_code": "Q1_WORK_STATUS",
      "question_code": "Q1",
      "question_description": "Work status",
      "question_label": "工作状态",
      "question_type": "Single Choice",
      "source_variables": ["Q1_WORK_STATUS"],
      "transformation_rules": null,
      "statistic_type": "categorical"
    },
    // Categorical - Single choice variable
    {
      "indicator_code": "Q5_SATISFACTION",
      "question_code": "Q5",
      "question_description": "Satisfaction",
      "question_label": "请评价您对产品的满意度",
      "question_type": "Rating Scale",
      "source_variables": ["Q5_SATISFACTION"],
      "explicit": ["1", "2", "3", "4", "5"],
      "transformation_rules": null,
      "statistic_type": "categorical"
    },
    // Categorical Transform - With array-based recoding rules
    {
      "indicator_code": "Q5_SATISFACTION_RECODED",
      "question_code": "Q5",
      "question_description": "Satisfaction (recoded)",
      "question_label": "满意度（重编码）",
      "question_type": "Single Choice",
      "source_variables": ["Q5_SATISFACTION"],
      "transformation_rules": "(1 THRU 3=99) (4=100) (5=101)",
      "statistic_type": "categorical"
    },
    // Categorical Transform - With range-based recoding rules
    {
      "indicator_code": "Q5_SATISFACTION_GROUPED",
      "question_code": "Q5",
      "question_description": "Satisfaction (grouped)",
      "question_label": "满意度分组",
      "question_type": "Single Choice",
      "source_variables": ["Q5_SATISFACTION"],
      "transformation_rules": "(1 THRU 2=1) (3=2) (4 THRU 5=3)",
      "statistic_type": "categorical"
    },
    // Computed Index - ALWAYS scalar (has COMPUTE in transformation_rules)
    {
      "indicator_code": "INCOME_INDEX",
      "question_code": "S1",
      "question_description": "Income index",
      "question_label": "收入指数",
      "question_type": "Numeric Input",
      "source_variables": ["SALARY_MONTHLY", "BONUS_MONTHLY", "OTHER_INCOME"],
      "transformation_rules": "COMPUTE INCOME_INDEX = SALARY_MONTHLY + BONUS_MONTHLY + OTHER_INCOME",
      "statistic_type": "scalar"
    },
    // Categorical Validation - With validation rules
    {
      "indicator_code": "S1_INCOME_VALIDATED",
      "question_code": "S1",
      "question_description": "Income (validated)",
      "question_label": "收入（验证）",
      "question_type": "Single Choice",
      "source_variables": ["S1_INCOME_MONTHLY"],
      "transformation_rules": "SELECT IF NOT MISSING(S1_INCOME_MONTHLY) AND S1_INCOME_MONTHLY GT 0",
      "statistic_type": "categorical"
    },
    // Scalar Transform - Numeric with recoding/grouping rules
    {
      "indicator_code": "S1_AGE_GROUP",
      "question_code": "S1",
      "question_description": "Age (grouped)",
      "question_label": "年龄分组",
      "question_type": "Numeric Input",
      "source_variables": ["S1_AGE"],
      "transformation_rules": "(0 THRU 25=1) (26 THRU 35=2) (36 THRU 45=3) (46 THRU 60=4) (61 THRU 99=5)",
      "statistic_type": "scalar"
    }
  ],

  "column_indicators": [
    // Demographic - Simple demographic variable
    {
      "indicator_code": "AGE_GROUP",
      "question_code": "S1",
      "question_description": "Age group",
      "question_label": "年龄分组",
      "question_type": "Single Choice",
      "source_variables": ["AGE_GROUP"],
      "explicit": ["1", "2", "3", "4", "5"],
      "transformation_rules": null,
      "statistic_type": "categorical"
    },
    // Demographic - Simple demographic variable
    {
      "indicator_code": "GENDER",
      "question_code": "Q1",
      "question_description": "Gender",
      "question_label": "性别",
      "question_type": "Single Choice",
      "source_variables": ["GENDER"],
      "explicit": ["1", "2"],
      "transformation_rules": null,
      "statistic_type": "categorical"
    },
    // Demographic - Simple demographic variable
    {
      "indicator_code": "REGION",
      "question_code": "D1",
      "question_description": "Region",
      "question_label": "地区",
      "question_type": "Single Choice",
      "source_variables": ["REGION"],
      "explicit": null,
      "transformation_rules": null,
      "statistic_type": "categorical"
    },
    // Demographic - Simple demographic variable
    {
      "indicator_code": "EDUCATION",
      "question_code": "D2",
      "question_description": "Education",
      "question_label": "教育程度",
      "question_type": "Single Choice",
      "source_variables": ["EDUCATION"],
      "explicit": ["1", "2", "3", "4", "5", "6"],
      "transformation_rules": null,
      "statistic_type": "categorical"
    },
    // Demographic - Simple demographic variable
    {
      "indicator_code": "INCOME",
      "question_code": "S1",
      "question_description": "Income",
      "question_label": "收入",
      "question_type": "Single Choice",
      "source_variables": ["INCOME"],
      "explicit": null,
      "transformation_rules": null,
      "statistic_type": "categorical"
    }
  ]
}
