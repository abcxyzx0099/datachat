{
  "metadata": {
    "spec_id": "crosstab_2024_consumer_survey_001",
    "project_id": "proj_2024_china_consumer_insights",
    "dataset_id": "ds_q1_2024_national_survey",
    "description": "Cross-tabulation analysis for market research survey"
  },

  "filter_clause": {
    "age_min": 18,
    "age_max": 65,
    "exclude_incomplete": true
  },

  "weight_indicator": "weight1",

  "row_indicators": [
    // Raw - Direct SPSS variable, no transformation
    {
      "indicator_code": "Q1_GENDER_RAW",
      "indicator_label": "Gender - Raw data",
      "questionnaire_questions": [
        {
          "code": "Q1",
          "label": "Gender",
          "type": "Single Choice"
        }
      ],
      "base_variables": [
        {
          "name": "Q1_GENDER_raw",
          "label": "Gender",
          "suffix": "_raw",
          "values": {
            "1": "Male",
            "2": "Female"
          },
          "generation": null
        }
      ],
      "tabulation_statistics": {
        "type": "categorical",
        "metric": "column_percent",
        "explicit": null
      }
    },
    // Raw - Numeric scalar variable
    {
      "indicator_code": "S1_AGE",
      "indicator_label": "Age - Numeric variable",
      "questionnaire_questions": [
        {
          "code": "S1",
          "label": "Age",
          "type": "Numeric Input"
        }
      ],
      "base_variables": [
        {
          "name": "S1_AGE_raw",
          "label": "Age (numeric)",
          "suffix": "_raw",
          "values": null,
          "generation": null
        }
      ],
      "tabulation_statistics": {
        "type": "scalar",
        "metric": "descriptive_statistics",
        "explicit": null
      }
    },
    // Binary - Awareness variable
    {
      "indicator_code": "Q1_BRAND_AWARENESS_BIN",
      "indicator_label": "Brand awareness - Binary",
      "questionnaire_questions": [
        {
          "code": "Q1",
          "label": "Brand awareness",
          "type": "Multiple Choice"
        }
      ],
      "base_variables": [
        {
          "name": "Q1_BRAND_A_bin",
          "label": "Brand A aware (Yes/No)",
          "suffix": "_bin",
          "values": {
            "1": "Yes",
            "0": "No"
          },
          "generation": null
        },
        {
          "name": "Q1_BRAND_B_bin",
          "label": "Brand B aware (Yes/No)",
          "suffix": "_bin",
          "values": {
            "1": "Yes",
            "0": "No"
          },
          "generation": null
        }
      ],
      "tabulation_statistics": {
        "type": "categorical",
        "metric": "column_percent",
        "explicit": null
      }
    },
    // Categorical - Recoded into groups
    {
      "indicator_code": "Q5_SATISFACTION_CAT",
      "indicator_label": "Satisfaction - Categorical groups",
      "questionnaire_questions": [
        {
          "code": "Q5",
          "label": "Satisfaction",
          "type": "Rating Scale"
        }
      ],
      "base_variables": [
        {
          "name": "Q5_SATISFACTION_cat",
          "label": "Satisfaction (grouped)",
          "suffix": "_cat",
          "values": {
            "1": "Low",
            "2": "Medium",
            "3": "High"
          },
          "generation": "RECODE Q5_SATISFACTION (1 THRU 2=1) (3=2) (4 THRU 5=3) INTO Q5_SATISFACTION_cat"
        }
      ],
      "tabulation_statistics": {
        "type": "categorical",
        "metric": "column_percent",
        "explicit": null
      }
    },
    // Top 2 Box - Highest categories combined
    {
      "indicator_code": "Q5_SATISFACTION_T2B",
      "indicator_label": "Satisfaction - Top 2 Box",
      "questionnaire_questions": [
        {
          "code": "Q5",
          "label": "Satisfaction",
          "type": "Rating Scale"
        }
      ],
      "base_variables": [
        {
          "name": "Q5_SATISFACTION_t2b",
          "label": "Satisfaction (Top 2 Box)",
          "suffix": "_t2b",
          "values": {
            "1": "Top 2 Box (Satisfied + Very Satisfied)",
            "0": "Others"
          },
          "generation": "RECODE Q5_SATISFACTION (4 THRU 5=1) (ELSE=0) INTO Q5_SATISFACTION_t2b"
        }
      ],
      "tabulation_statistics": {
        "type": "categorical",
        "metric": "column_percent",
        "explicit": null
      }
    },
    // Bottom 2 Box - Lowest categories combined
    {
      "indicator_code": "Q5_SATISFACTION_B2B",
      "indicator_label": "Satisfaction - Bottom 2 Box",
      "questionnaire_questions": [
        {
          "code": "Q5",
          "label": "Satisfaction",
          "type": "Rating Scale"
        }
      ],
      "base_variables": [
        {
          "name": "Q5_SATISFACTION_b2b",
          "label": "Satisfaction (Bottom 2 Box)",
          "suffix": "_b2b",
          "values": {
            "1": "Bottom 2 Box (Dissatisfied + Very Dissatisfied)",
            "0": "Others"
          },
          "generation": "RECODE Q5_SATISFACTION (1 THRU 2=1) (ELSE=0) INTO Q5_SATISFACTION_b2b"
        }
      ],
      "tabulation_statistics": {
        "type": "categorical",
        "metric": "column_percent",
        "explicit": null
      }
    },
    // NPS - Net Promoter Score categorization
    {
      "indicator_code": "Q6_NPS_CATEGORY",
      "indicator_label": "NPS - Promoter/Passive/Detractor",
      "questionnaire_questions": [
        {
          "code": "Q6",
          "label": "Recommendation likelihood",
          "type": "Rating Scale"
        }
      ],
      "base_variables": [
        {
          "name": "Q6_NPS_nps",
          "label": "NPS Category",
          "suffix": "_nps",
          "values": {
            "3": "Promoter (9-10)",
            "2": "Passive (7-8)",
            "1": "Detractor (0-6)"
          },
          "generation": "RECODE Q6_RECOMMEND (9 THRU 10=3) (7 THRU 8=2) (0 THRU 6=1) INTO Q6_NPS_nps"
        }
      ],
      "tabulation_statistics": {
        "type": "categorical",
        "metric": "column_percent",
        "explicit": null
      }
    },
    // Index - Computed satisfaction index
    {
      "indicator_code": "SATISFACTION_INDEX",
      "indicator_label": "Satisfaction index - Mean of all attributes",
      "questionnaire_questions": [
        {
          "code": "Q5",
          "label": "Satisfaction attributes",
          "type": "Rating Scale"
        }
      ],
      "base_variables": [
        {
          "name": "SATISFACTION_idx",
          "label": "Satisfaction Index",
          "suffix": "_idx",
          "values": null,
          "generation": "COMPUTE SATISFACTION_idx = MEAN(Q5A_PRODUCT, Q5B_SERVICE, Q5C_SUPPORT, Q5D_VALUE)"
        }
      ],
      "tabulation_statistics": {
        "type": "scalar",
        "metric": "descriptive_statistics",
        "explicit": null
      }
    },
    // Z-score - Normalized score
    {
      "indicator_code": "D1_QUALITY_ZSCORE",
      "indicator_label": "Quality rating - Z-score normalized",
      "questionnaire_questions": [
        {
          "code": "D1",
          "label": "Attribute ratings",
          "type": "Rating Scale"
        }
      ],
      "base_variables": [
        {
          "name": "D1_QUALITY_z",
          "label": "Quality (Z-score)",
          "suffix": "_z",
          "values": null,
          "generation": "COMPUTE D1_QUALITY_z = (D1_QUALITY - MEAN(D1_QUALITY)) / SD(D1_QUALITY)"
        }
      ],
      "tabulation_statistics": {
        "type": "scalar",
        "metric": "descriptive_statistics",
        "explicit": null
      }
    },
    // Percentile - Percentile rank
    {
      "indicator_code": "D1_PRICE_PERCENTILE",
      "indicator_label": "Price rating - Percentile rank",
      "questionnaire_questions": [
        {
          "code": "D1",
          "label": "Price rating",
          "type": "Rating Scale"
        }
      ],
      "base_variables": [
        {
          "name": "D1_PRICE_pct",
          "label": "Price (percentile)",
          "suffix": "_pct",
          "values": null,
          "generation": "COMPUTE D1_PRICE_pct = RANK(D1_PRICE) / N * 100"
        }
      ],
      "tabulation_statistics": {
        "type": "scalar",
        "metric": "descriptive_statistics",
        "explicit": null
      }
    },
    // Multiple Base Variables - Rating scale attributes
    {
      "indicator_code": "D1_ATTRIBUTE_RATINGS",
      "indicator_label": "Attribute ratings - All dimensions",
      "questionnaire_questions": [
        {
          "code": "D1",
          "label": "Attribute ratings",
          "type": "Rating Scale"
        }
      ],
      "base_variables": [
        {
          "name": "D1_QUALITY_raw",
          "label": "Quality rating",
          "suffix": "_raw",
          "values": null,
          "generation": null
        },
        {
          "name": "D1_PRICE_raw",
          "label": "Price rating",
          "suffix": "_raw",
          "values": null,
          "generation": null
        },
        {
          "name": "D1_SERVICE_raw",
          "label": "Service rating",
          "suffix": "_raw",
          "values": null,
          "generation": null
        },
        {
          "name": "D1_SELECTION_raw",
          "label": "Selection rating",
          "suffix": "_raw",
          "values": null,
          "generation": null
        },
        {
          "name": "D1_VALUE_raw",
          "label": "Value rating",
          "suffix": "_raw",
          "values": null,
          "generation": null
        }
      ],
      "tabulation_statistics": {
        "type": "scalar",
        "metric": "descriptive_statistics",
        "explicit": null
      }
    },
    // Multiple Related Questions - Composite satisfaction
    {
      "indicator_code": "SATISFACTION_COMPOSITE",
      "indicator_label": "Satisfaction - Multiple dimensions",
      "questionnaire_questions": [
        {
          "code": "Q5A",
          "label": "Product Satisfaction",
          "type": "Rating Scale"
        },
        {
          "code": "Q5B",
          "label": "Service Satisfaction",
          "type": "Rating Scale"
        },
        {
          "code": "Q5C",
          "label": "Support Satisfaction",
          "type": "Rating Scale"
        }
      ],
      "base_variables": [
        {
          "name": "Q5A_SAT_t2b",
          "label": "Product Satisfaction (Top 2 Box)",
          "suffix": "_t2b",
          "values": {
            "1": "Top 2 Box",
            "0": "Others"
          },
          "generation": "RECODE Q5A (4 THRU 5=1) (ELSE=0) INTO Q5A_SAT_t2b"
        },
        {
          "name": "Q5B_SAT_t2b",
          "label": "Service Satisfaction (Top 2 Box)",
          "suffix": "_t2b",
          "values": {
            "1": "Top 2 Box",
            "0": "Others"
          },
          "generation": "RECODE Q5B (4 THRU 5=1) (ELSE=0) INTO Q5B_SAT_t2b"
        },
        {
          "name": "Q5C_SAT_t2b",
          "label": "Support Satisfaction (Top 2 Box)",
          "suffix": "_t2b",
          "values": {
            "1": "Top 2 Box",
            "0": "Others"
          },
          "generation": "RECODE Q5C (4 THRU 5=1) (ELSE=0) INTO Q5C_SAT_t2b"
        }
      ],
      "tabulation_statistics": {
        "type": "categorical",
        "metric": "column_percent",
        "explicit": null
      }
    }
  ],

