# =============================================================================
# DataChat SPSS Analyzer - Environment Configuration
# =============================================================================
# Copy this file to .env and configure your settings
#
# Configuration Priority: Environment Variables > DEFAULT_CONFIG
# =============================================================================

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# You must configure at least one LLM provider. The application supports
# three providers: Kimi (Moonshot AI), DeepSeek, and Zhipu GLM (BigModel).
#
# Select your active provider using LLM_PROVIDER below.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider Selection
# -----------------------------------------------------------------------------
# Required: Select which LLM provider to use
# Options: KIMI, DEEPSEEK, ZHIPU
LLM_PROVIDER=ZHIPU

# -----------------------------------------------------------------------------
# Kimi (Moonshot AI)
# -----------------------------------------------------------------------------
# Sign up at: https://platform.moonshot.cn/
# Required if LLM_PROVIDER=KIMI
KIMI_API_KEY=your-kimi-api-key-here

# Optional: Override default Kimi settings
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2-turbo-preview

# -----------------------------------------------------------------------------
# DeepSeek
# -----------------------------------------------------------------------------
# Sign up at: https://platform.deepseek.com/
# Required if LLM_PROVIDER=DEEPSEEK
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Optional: Override default DeepSeek settings
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# Alternative model: DEEPSEEK_MODEL=deepseek-reasoner (for complex reasoning)

# -----------------------------------------------------------------------------
# Zhipu GLM (BigModel)
# -----------------------------------------------------------------------------
# Sign up at: https://open.bigmodel.cn/
# Required if LLM_PROVIDER=ZHIPU
ZHIPU_API_KEY=your-zhipu-api-key-here

# Optional: Override default Zhipu settings
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
ZHIPU_MODEL=glm-4.7

# =============================================================================
# LLM API Settings (Optional)
# =============================================================================

# Temperature controls randomness in LLM responses (0.0 = deterministic, 1.0 = random)
# Lower values (0.0-0.2) are recommended for consistent artifact generation
LLM_TEMPERATURE=0.1

# Maximum tokens per LLM response
LLM_MAX_TOKENS=4000

# Maximum validation retry iterations (self-correction)
LLM_MAX_SELF_CORRECTION_ITERATIONS=3

# =============================================================================
# Filtering Thresholds (Optional)
# =============================================================================

# Maximum distinct values before filtering as high-cardinality
# Variables with more distinct values than this threshold will be excluded
HIGH_CARDINALITY_THRESHOLD=30

# Filter out binary variables (variables with exactly 2 distinct values)
FILTER_BINARY=true

# Filter out "other" text fields (open-ended feedback)
FILTER_OTHER_TEXT=true

# =============================================================================
# Statistical Significance Thresholds (Optional)
# =============================================================================

# p-value threshold for statistical significance (default: 0.05)
# Lower values (e.g., 0.01) apply stricter significance criteria
SIGNIFICANCE_LEVEL=0.05

# Minimum Cramer's V effect size for filtering tables
MIN_CRAMERS_V=0.1

# Minimum expected cell count for chi-square validity
MIN_CELL_COUNT=10

# =============================================================================
# Paths (Optional)
# =============================================================================

# PSPP executable path (use "pspp" for system PATH, or provide full path)
PSPP_PATH=/usr/bin/pspp

# Output directory (relative to project root)
OUTPUT_DIR=output

# Temporary files directory (relative to project root)
TEMP_DIR=temp

# =============================================================================
# Human Review Configuration (Optional)
# =============================================================================

# Enable human-in-the-loop review for all artifacts
# When set to 'true', the workflow will pause at review nodes for approval
ENABLE_HUMAN_REVIEW=true

# =============================================================================
# Notes
# =============================================================================
#
# 1. Provider Selection:
#    - Only the API key for the selected LLM_PROVIDER is required
#    - Other providers' API keys can be left empty
#    - Switch providers by changing LLM_PROVIDER and restarting
#
# 2. Environment Variable Priority:
#    - Environment variables override DEFAULT_CONFIG values
#    - See agent/config.py for all available configuration options
#
# 3. File Paths:
#    - All paths are relative to project root unless absolute path provided
#
# 4. Backward Compatibility:
#    - SURVEY_ prefixed variables are also supported (e.g., SURVEY_LLM_PROVIDER)
# =============================================================================
