{
  // ============================================================================
  // Demographic Variables Template
  // For column indicators: age groups, gender, region, education, etc.
  // Statistics: LABEL only (no statistics on demographic columns)
  // ============================================================================
  "demographic_variables": {
    "categories": {
      "order": "A",
      "sort_key": "VALUE",
      "include_missing": false,
      "totals": {
        "show": true,
        "label": "合计",
        "position": "AFTER"
      },
      "empty": "EXCLUDE"
    },
    "display": {
      "variable_label": "BOTH",
      "category_label_position": "AUTO",
      "hide_empty_categories": true
    },
    "statistics": {
      "count": true,
      "mean": false,
      "median": false,
      "mode": false,
      "stddev": false,
      "variance": false,
      "min": false,
      "max": false,
      "sum": false,
      "range": false,
      "semean": false,
      "missing": true,
      "ptile": null
    },
    "missing_values": "exclude"
  },

  // ============================================================================
  // Raw Variables Template
  // For row indicators: Direct SPSS variables, no transformation
  // Statistics: User-defined (can be categorical or scalar based on settings_template)
  // ============================================================================
  "raw_variables": {
    "categories": {
      "order": "A",
      "sort_key": "VALUE",
      "include_missing": false,
      "totals": {
        "show": true,
        "label": "小计",
        "position": "AFTER"
      },
      "empty": "EXCLUDE"
    },
    "display": {
      "variable_label": "BOTH",
      "category_label_position": "AUTO",
      "hide_empty_categories": true
    },
    "statistics": {
      "count": true
    },
    "missing_values": "exclude"
  },

  // ============================================================================
  // Categorical Variables Template
  // For row indicators: Single choice variables
  // Statistics: COUNT COLPCT
  // ============================================================================
  "categorical_variables": {
    "categories": {
      "order": "A",
      "sort_key": "VALUE",
      "include_missing": false,
      "totals": {
        "show": true,
        "label": "总计",
        "position": "AFTER"
      },
      "empty": "EXCLUDE"
    },
    "percentages": {
      "show_row_pct": false,
      "show_col_pct": true,
      "show_table_pct": false
    },
    "display": {
      "variable_label": "BOTH",
      "category_label_position": "AUTO",
      "hide_empty_categories": true
    },
    "statistics": {
      "count": true,
      "mean": false,
      "median": false,
      "mode": false,
      "stddev": false,
      "variance": false,
      "min": false,
      "max": false,
      "sum": false,
      "range": false,
      "semean": false,
      "missing": true,
      "ptile": null
    },
    "missing_values": "exclude"
  },

  // ============================================================================
  // Scalar Variables Template
  // For row indicators: Numeric continuous variables
  // Statistics: MEAN MEDIAN STDDEV MIN MAX
  // ============================================================================
  "scalar_variables": {
    "categories": {
      "order": "A",
      "sort_key": "VALUE",
      "include_missing": false,
      "totals": {
        "show": true,
        "label": "合计",
        "position": "AFTER"
      },
      "empty": "EXCLUDE"
    },
    "percentages": {
      "show_row_pct": false,
      "show_col_pct": false,
      "show_table_pct": false
    },
    "display": {
      "variable_label": "LABEL",
      "category_label_position": "AUTO",
      "hide_empty_categories": true
    },
    "statistics": {
      "count": true,
      "mean": true,
      "median": true,
      "mode": false,
      "stddev": true,
      "variance": false,
      "min": true,
      "max": true,
      "sum": false,
      "range": false,
      "semean": false,
      "missing": true,
      "ptile": null
    },
    "missing_values": "exclude"
  },

  // ============================================================================
  // Indicator Variables Template
  // For row indicators: Multiple source variables combined into indicators
  // Statistics: COUNT COLPCT (categorical) or user-defined statistics
  // ============================================================================
  "indicator_variables": {
    "categories": {
      "order": "A",
      "sort_key": "VALUE",
      "include_missing": false,
      "totals": {
        "show": true,
        "label": "总计",
        "position": "AFTER"
      },
      "empty": "EXCLUDE"
    },
    "display": {
      "variable_label": "BOTH",
      "category_label_position": "AUTO",
      "hide_empty_categories": true
    },
    "statistics": {
      "count": true,
      "mean": false,
      "median": false,
      "mode": false,
      "stddev": false,
      "variance": false,
      "min": false,
      "max": false,
      "sum": false,
      "range": false,
      "semean": false,
      "missing": true,
      "ptile": null
    },
    "missing_values": "exclude"
  },

  // ============================================================================
  // Default Display Options
  // ============================================================================
  "default_display_options": {
    "table_format": "compact",
    "empty_display": "BLANK",
    "missing_display": "N/A",
    "variable_labels": "BOTH",
    "hide_empty_rows": true,
    "hide_empty_columns": false,
    "sort_by": "label"
  },

  // ============================================================================
  // Default Chart Configuration
  // ============================================================================
  "default_chart_config": {
    "chart_type": "stacked_bar",
    "color_scheme": "corporate_blue",
    "show_labels": true,
    "show_legend": true,
    "title_template": "{row} × {column}"
  }
}
